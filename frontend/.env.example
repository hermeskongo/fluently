# URL de base de l'API (sans slash final)
# En local : http://localhost:5001/api
VITE_BACKEND_URL=http://localhost:5001/api

# Cle PUBLIQUE Stream uniquement (la meme que STREAM_API_KEY cote backend).
# Ne jamais mettre STREAM_API_SECRET ici : tout ce qui est prefixe VITE_ est
# embarque dans le bundle et donc visible par n'importe quel visiteur.
VITE_STREAM_API_KEY=
