# Port d'ecoute de l'API
PORT=5001

# PostgreSQL — chaine de connexion complete (Neon, Railway, ou instance locale)
DATABASE_URL=postgresql://user:password@localhost:5432/fluently

# Secret de signature des JWT — generer une valeur aleatoire longue
# ex: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# Identifiants Stream (https://getstream.io) — dashboard > App Access Keys
# La cle secrete ne doit JAMAIS se retrouver cote frontend.
STREAM_API_KEY=
STREAM_API_SECRET=

# "production" active le flag Secure sur le cookie de session
NODE_ENV=development
